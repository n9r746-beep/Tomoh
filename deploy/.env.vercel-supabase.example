# TOMOH Weekly Report Automation — Vercel + Supabase Environment Variables Template
# Set these in Vercel Project Settings -> Environment Variables (Server-Side Only; NEVER prefix with NEXT_PUBLIC_)

# Supabase PostgreSQL 16 Transaction Pooler URL (SSL required)
TOMOH_DATABASE_URL=postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Private Storage (Server-Side Only)
TOMOH_STORAGE_BACKEND=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SERVER_SIDE_ONLY_SERVICE_ROLE_KEY>

# Template & Ephemeral Serverless Scratch Dir
TOMOH_TEMPLATE_BUCKET=tomoh-templates
TOMOH_TEMPLATE_OBJECT=master_template.pptx
TOMOH_OUTPUT_DIR=/tmp/tomoh_generated
TOMOH_UPLOADS_DIR=/tmp/tomoh_uploads

# Authentication & Security
TOMOH_AUTH_MODE=external_oidc
TOMOH_AI_ASSISTANT_ENABLED=false
TOMOH_VISUAL_VALIDATION=false
