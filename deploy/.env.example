# TOMOH Weekly Report Automation — Staging Environment Template (NO REAL CREDENTIALS)
POSTGRES_DB=tomoh_reports
POSTGRES_USER=tomoh_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_SECRET

TOMOH_DATABASE_URL=postgresql://tomoh_app:CHANGE_ME_STRONG_SECRET@db:5432/tomoh_reports
TOMOH_TEMPLATE_PPTX=/var/lib/tomoh/templates/master_template.pptx
TOMOH_MAPPING_CONFIG=/app/config/mapping_config.json
TOMOH_OUTPUT_DIR=/var/lib/tomoh/generated
TOMOH_UPLOADS_DIR=/var/lib/tomoh/uploads

# Switch to external_oidc once organizational SSO/OIDC is wired in app/auth.py
TOMOH_AUTH_MODE=external_oidc
TOMOH_AI_ASSISTANT_ENABLED=false
TOMOH_VISUAL_VALIDATION=false
